# Copia este archivo como .env (no se sube a git) y llena los valores.
# Tambien puedes definirlas como variables de entorno del sistema o en la configuracion de ejecucion del IDE.

# Base de datos MySQL
DB_USERNAME=
DB_PASSWORD=

# Clave para firmar los tokens JWT (cadena larga y aleatoria)
JWT_SECRET_KEY=

# Usuario administrador que se crea al iniciar la aplicacion si no existe
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cuenta para el envio de correos (opcional; vacio desactiva el envio)
EMAIL_SENDER=
EMAIL_PASSWORD=
