# Copia este archivo como .env y llena los valores. No subas .env al repositorio.

# Base de datos
DB_URL=jdbc:mysql://localhost:3306/mobiliario_eventos
DB_USERNAME=root
DB_PASSWORD=

# JWT: clave en Base64 de al menos 256 bits (openssl rand -base64 32)
JWT_SECRET_KEY=
# Duracion del token en milisegundos (opcional, por defecto 24 horas)
JWT_EXPIRATION=86400000

# Usuario administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Email (opcional): cuenta de Gmail y su contrasena de aplicacion
EMAIL_SENDER=
EMAIL_PASSWORD=
